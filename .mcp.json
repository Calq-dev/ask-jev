{
  "mcpServers": {
    "ask-jev": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server.mjs"],
      "env": {
        "ASK_JEV_API_KEY": "${user_config.apiKey}",
        "ASK_JEV_MODEL": "${user_config.model}",
        "ASK_JEV_MAX_CHARS": "${user_config.maxChars}"
      }
    }
  }
}
