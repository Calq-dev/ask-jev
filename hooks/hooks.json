{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/remind.mjs\"",
            "commandWindows": "node \"%CLAUDE_PLUGIN_ROOT%\\hooks\\remind.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
